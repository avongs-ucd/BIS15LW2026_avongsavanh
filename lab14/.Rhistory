library(tidyverse)
library(janitor)
#install.packages("ggmap")
library(ggmap)
#install.packages("leaflet")
library(leaflet)
#register_stadiamaps("YOUR API KEY HERE", write = FALSE)
register_stadiamaps("efbbad0c-b639-4a5e-bc42-a820b574fc9b", write = FALSE)
spiders <- read_csv("data/spiders_with_locs.csv")%>%
clean_names() %>%
filter(latitude<=42)
spiders %>%
select(latitude, longitude) %>%
summary()
lat <- c(34.67, 41.80)
long <- c(-124.1, -115.5)
bbox <- make_bbox(long, lat, f = 0.03)
map1 <- get_stadiamap(bbox, maptype = "stamen_terrain", zoom = 7)
ggmap(map1)
ggmap(map1) +
geom_point(data = spiders, aes(longitude, latitude), size = 0.75, color = "black", alpha = 0.8) +
labs(x = "Longitude",
y = "Latitude",
title = "California Usofila Records")
spiders %>%
summarize(
lon_min = min(longitude, na.rm = T),
lon_max = max(longitude, na.rm = T),
lat_min = min(latitude, na.rm = T),
lat_max = max(latitude, na.rm = T))
lon_min <- -124.13
lon_max <- -115.49
lat_min <- 34.67
lat_max <- 41.8
leaflet(spiders) %>%
addProviderTiles(providers$Stadia.StamenTerrain) %>%
addCircleMarkers(
lng = ~longitude,
lat = ~latitude,
radius = 2,
stroke = FALSE,
fillOpacity = 0.7
) %>%
addScaleBar(position = "bottomleft") %>%
fitBounds(lng1 = lon_min,
lat1 = lat_min,
lng2 = lon_max,
lat2 = lat_max)
leaflet(spiders) %>%
addTiles() %>%
addProviderTiles(providers$Stadia.StamenTerrain) %>%
addCircleMarkers(
lng = ~longitude,
lat = ~latitude,
radius = 2,
stroke = FALSE,
fillOpacity = 0.7
) %>%
addScaleBar(position = "bottomleft") %>%
fitBounds(lng1 = lon_min,
lat1 = lat_min,
lng2 = lon_max,
lat2 = lat_max)
