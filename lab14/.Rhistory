#install.packages("shiny")
library("shiny")
library(tidyverse)
library(janitor)
#install.packages("ggmap")
library(ggmap)
#install.packages("leaflet")
library(leaflet)
#register_stadiamaps("YOUR API KEY HERE", write = FALSE)
register_stadiamaps("efbbad0c-b639-4a5e-bc42-a820b574fc9b", write = FALSE)
spiders <- read_csv("data/spiders_with_locs.csv")%>%
clean_names() %>%
filter(latitude<=42)
spiders %>%
select(latitude, longitude) %>%
summary()
lat <- c(34.67, 41.80)
long <- c(-124.1, -115.5)
bbox <- make_bbox(long, lat, f = 0.03)
map1 <- get_stadiamap(bbox, maptype = "stamen_terrain", zoom = 7)
ggmap(map1)
ggmap(map1) +
geom_point(data = spiders, aes(longitude, latitude), size = 0.75, color = "black", alpha = 0.8) +
labs(x = "Longitude",
y = "Latitude",
title = "California Usofila Records")
