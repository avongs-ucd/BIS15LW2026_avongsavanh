knitr::opts_chunk$set(echo = TRUE)
library(tidyverse)
library(janitor)
sydneybeaches <- read_csv("data/sydneybeaches.csv")
glimpse(sydneybeaches)
# The tidyverse defintion of the data being tidy is if in the data:
#(1) each variable has its own column
#(2) each observation has its own row
#(3) each value has its own cell
# In this data, all of above conditions are fulfilled, so the data here is tidy.
# This data is in the long format. *Note: long or wide data can be tidy
sydneybeaches_long <- sydneybeaches %>%
select(Site, Date, `Enterococci (cfu/100ml)`)
sydneybeaches_long
sydneybeaches_wide <- sydneybeaches_long %>%
pivot_wider(
names_from = "Date",
values_from = "Enterococci (cfu/100ml)"
)
sydneybeaches_wide
sydneybeaches_wide <- sydneybeaches_wide %>%
pivot_longer(-Site,
names_to = "data",
values_to = "enterococci_cfu_100ml",
)
sydneybeaches_wide
sydneybeaches_long <- sydneybeaches_long %>%
pivot_longer(
names_to = c("day", "month", "year"),
names_sep = "_",
values_to = "enterococci_cfu_100ml")
library("tidyverse")
library("janitor")
heartrate <- read_csv("data/heartrate.csv")
heartrate
heartrate %>%
filter(patient == "Margaret") %>%
ggplot(mapping = aes(x = a, y = patient)) +
geom_boxplot(mapping = aes(color = a))
heartrate %>%
pivot_longer(-patient,
names_to = "drug",
values_to = "heartrate")
heartrate %>%
pivot_longer(-patient,
names_to = "drug",
values_to = "heartrate") %>%
filter(patient == "Margaret") %>%
ggplot(mapping = aes(x = drug, y = heartrate)) +
geom_col()
relig_income <- read.csv("data/relig_income.csv")
relig_income %>%
pivot_longer(-religion, #don't move
names_to = "income", #move to column
values_to = "total") #move to column
billboard <- read_csv("data/billboard.csv")
billboard
billboard %>%
pivot_longer(wk1:wk76,
names_to = "week",
values_to = "rank",
values_drop_na = T)
billboard %>%
pivot_longer(-c(artist, track, date.entered), #not numerically ordered
names_to = "week",
values_to = "rank",
values_drop_na = T)
billboard %>%
pivot_longer(
cols = starts_with("wk"),
names_to = "week",
names_prefix = "wk", #gets rid of the wk in each entry like wk1, wk2, wk3, etc.
values_to = "rank",
values_drop_na = T)
plant_data <- read_csv("data/plant_data.csv")
plant_data %>%
pivot_longer(day1:day30,
names_to = "day",
names_prefix = "day",
values_to = "idk",
values_drop_na = T)
# pivot_longer(-c(genotype, water_sched_prog, greenhouse),
#           names_to = "day",
#          names_prefix = "day",
#          values_to = "idk",
#         values_drop_na = T)
qpcr_untidy <- read_csv("data/qpcr_untidy.csv")
qpcr_untidy
qpcr_untidy <- qpcr_untidy %>%
pivot_longer(
exp1_rep1:exp3_rep3,
names_to = c("experiment", "replicate"),
names_sep = "_",
values_to = "mRNA expression"
)
qpcr_untidy %>%
separate(experiment, into = c("experiment", "e_number"), sep = 3) %>%
separate(replicate, into = c("replicate", "r_number"), sep = 3) %>%
select(gene, experiment = e_number, replicate = r_number, 'mRNA expression')
sydneybeaches_long <- sydneybeaches_long %>%
pivot_longer(
names_to = c("day", "month", "year"),
names_sep = "/",
values_to = "enterococci_cfu_100ml")
sydneybeaches_wide <- sydneybeaches_wide %>%
pivot_longer(-Site,
names_to = "data",
values_to = "enterococci_cfu_100ml",
)
