knitr::opts_chunk$set(echo = TRUE)
library(tidyverse)
library(janitor)
sydneybeaches <- read_csv("data/sydneybeaches.csv")
glimpse(sydneybeaches)
# The tidyverse defintion of the data being tidy is if in the data:
#(1) each variable has its own column
#(2) each observation has its own row
#(3) each value has its own cell
# In this data, all of above conditions are fulfilled, so the data here is tidy.
# This data is in the long format. *Note: long or wide data can be tidy
sydneybeaches_long <- sydneybeaches %>%
select(Site, Date, `Enterococci (cfu/100ml)`)
sydneybeaches_long
sydneybeaches_wide <- sydneybeaches_long %>%
pivot_wider(
names_from = "Date",
values_from = "Enterococci (cfu/100ml)"
)
sydneybeaches_wide
sydneybeaches_wide <- sydneybeaches_wide %>%
pivot_longer(-Site,
names_to = "data",
values_to = "enterococci_cfu_100ml",
)
sydneybeaches_wide
sydneybeaches_long <- sydneybeaches_long %>%
separate(Date, into = c("day", "month", "year"), sep = "/")
sydneybeaches_long
sydneybeaches_avg <- sydneybeaches_long %>%
group_by(Site, year) %>%
summarize(mean_enterococci_cfu_100ml = mean(`Enterococci (cfu/100ml)`, na.rm = TRUE))
sydneybeaches_avg
sydneybeaches_avg <- sydneybeaches_avg %>%
pivot_wider(
names_from = "Site",
values_from = "mean_enterococci"
)
sydneybeaches_avg <- sydneybeaches_avg %>%
pivot_wider(
names_from = "Site",
values_from = "mean_enterococci_cfu_100ml"
)
sydneybeaches_avg
sydneybeaches_avg %>%
filter(year == "2013") %>%
arrange(desc(mean_enterococci_cfu_100ml)
sydneybeaches_avg %>%
filter(year == "2013") %>%
arrange(desc(mean_enterococci_cfu_100ml))
sydneybeaches_avg <- sydneybeaches_avg %>%
pivot_wider(
names_from = "Site",
values_from = "mean_enterococci_cfu_100ml"
)
sydneybeaches_avg <- sydneybeaches_avg %>%
pivot_wider(
names_from = "Site",
values_from = "mean_enterococci_cfu_100ml"
)
sydneybeaches_avg <- sydneybeaches_avg %>%
pivot_wider(
names_from = "Site",
values_from = "mean_enterococci_cfu_100ml"
)
sydneybeaches_avg <- sydneybeaches_long %>%
group_by(Site, year) %>%
summarize(mean_enterococci_cfu_100ml = mean(`Enterococci (cfu/100ml)`, na.rm = TRUE))
sydneybeaches_avg
sydneybeaches_avg <- sydneybeaches_avg %>%
pivot_wider(
names_from = "Site",
values_from = "mean_enterococci_cfu_100ml"
)
sydneybeaches_avg
sydneybeaches_avg %>%
filter(year == "2013") %>%
arrange(desc(mean_enterococci_cfu_100ml))
sydneybeaches_avg %>%
pivot_longer(-year, names_to = "site", values_to = "mean_enterococci_cfu_100ml") %>%
filter(year == "2013") %>%
arrange(desc(mean_enterococci_cfu_100ml))
sydneybeaches_long %>%
filter(year == "2013") %>%
arrange(desc(enterococci_cfu_100ml))
sydneybeaches_long# %>%
#  filter(year == "2013") %>%
# arrange(desc(enterococci_cfu_100ml))
sydneybeaches_long %>%
filter(year == "2013") %>%
arrange(desc(Enterococci (cfu/100ml)))
sydneybeaches_long %>%
filter(year == "2013") %>%
arrange(desc(`Enterococci (cfu/100ml)`))
# Analysis will be for Little Bay Beach (the most polluted beach in 2013), which years had the highest average of Enterococci (cfu/100ml)?
sydneybeaches_avg %>%
pivot_longer(-year,
names_to = "site",
values_to = "mean_enterococci_cfu_100ml"
) %>%
filter(site == "Little Bay Beach") %>%
arrange(desc(mean_enterococci_cfu_100ml))
