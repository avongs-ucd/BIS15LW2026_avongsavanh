top10_blastx <- goi_01_blastx %>%
slice_min(e_value, n = 10) %>%
select(scientific_name, cluster_ancestor, representative_sequence, max_score, query_cover, e_value, per_ident)
top10_blastx
top10_blastx %>%
ggplot(aes(x = reorder(representative_sequence, per_ident), y = per_ident, fill = representative_sequence)) +
geom_col() +
coord_flip() +
labs(title = "Percent Identity of Top 10 Blastx Hits",
x = "Representative Sequence (Organism)",
y = "Percent Identity (%)") +
theme_minimal() +
theme(legend.position = "none")
top10_blastx %>%
# ggplot(aes(x = reorder(representative_sequence, per_ident), y = per_ident, fill = representative_sequence)) +
