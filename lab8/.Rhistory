options(scipen = 999)
fisheries_clean <- read_csv("data/fisheries_clean.csv")
glimpse(fisheries_clean)
names(fisheries_clean)
dim(fisheries_clean)
fisheries_clean <- fisheries_clean %>%
mutate(across(c(period, continent, geo_region, country, scientific_name, common_name, taxonomic_code), as.factor))
fisheries_clean
#Skip this problem for now.
fisheries_clean %>%
distinct(country)
#figure out how to count number of distinct entries
fisheries_clean %>%
distinct(common_name, taxonomic_code) #can do summarize as well
fisheries_clean %>% #group by country because you use summarize later, take sum of the total catch for 7 (make a new column)
filter(period == 2023) %>%
select(period, country, catch) %>%
arrange(desc(catch)) %>%
slice_max(catch, n = 5)
fisheries_clean %>%
filter(period == 2023) %>%
select(period, country, catch, common_name) %>%
arrange(desc(catch)) %>%
slice_max(catch, n = 10)
