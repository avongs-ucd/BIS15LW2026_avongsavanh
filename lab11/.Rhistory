library(tidyverse)
library(janitor)
options(scipen=999) #cancels the use of scientific notation for the session
gap <- read_csv("data/gapminder.csv") %>% clean_names()
gap %>%
filter((year >= 2000 & year <= 2025) & country == "USA") %>%
ggplot(aes(x = year, y = gdp)) +
geom_line() +
geom_point(shape = 5) +
scale_x_continuous(breaks = 2000:2025, minor_breaks = NULL) +
theme(axis.text.x = element_text(angle = 60, hjust = 1)) +
labs(title = "GDP per Capita in the USA, 2000-2025",
x = "Year",
y = "GDP")
gap %>%
filter((year >= 2000 & year <= 2025) & country == "USA") %>%
ggplot(aes(x = year, y = gdp)) +
geom_line(color = "red") +
geom_point(shape = 5) +
scale_x_continuous(breaks = seq(2000, 2025, by = 5), minor_breaks = NULL) + #minor_breaks are just extra line dividers that are not labelled (white vertical lines in this case)
theme(axis.text.x = element_text(angle = 60, hjust = 1)) +
labs(title = "GDP per Capita in the USA, 2000-2025",
x = "Year",
y = "GDP")
gap %>%
filter(year == 1935) %>%
ggplot(aes(x = lex)) +
geom_histogram()
gap %>%
filter(year == 1935) %>%
ggplot(aes(x = lex)) +
geom_histogram(color = "black", fill = "turquoise", bins = 30) +
labs(title = "Distribution of Life Expectancy")
gap %>%
filter(year == 1935) %>%
ggplot(aes(x = lex)) +
geom_density(color = "black", fill = "turquoise", alpha = 0.7) +
labs(title = "Distribution of Life Expectancy")
gap %>%
filter(year == 1935) %>%
ggplot(aes(x = lex)) +
geom_histogram(aes(y = after_stat(density)), color = "black", fill = "turquoise") +
geom_density(color = "red")
labs(title = "Distribution of Life Expectancy")
gap %>%
filter(year %in% c(1930, 1950)) %>% #pull out years
mutate(year = factor(year)) %>% #change to factor
ggplot(aes(x = lex, color = year, fill = year)) +
geom_density(alpha = 0.3) +
labs(title = "Change in Distribution of Life Expectancy between 1930 and 1950",
x = "Life Expectancy (years)",
y = NULL,
color = "Year",
fill = "Year")
income_cat2000 <- gap %>%
filter(year == 2000) %>%
mutate(income_category = case_when(gdp <= 1100 ~ "low",
gdp > 1100 & gdp <= 4500 ~ "low_middle",
gdp > 4500 & gdp <= 13900 ~ "upper_middle",
gdp > 13900 ~ "high")) %>%
select(country, gdp, income_category) %>%
mutate(income_category = factor(income_category,
levels = c("low",
"low_middle",
"upper_middle",
"high")))
income_cat2000
income_cat2000 %>%
#summarize(n_country = n_distinct(country)) %>%
group_by(income_category) %>%
summarize(count = n())
income_cat2000 %>%
drop_na(income_category) %>% #get rid of NA's
ggplot(aes(x = income_category, fill = income_category)) +
geom_bar() +
labs(title = "Number of Countries in each Income Category in 2000",
x = "Income Category",
y = "Count") +
theme(legend.position = "none")
gapminder %>%
filter(year == 1925 | year == 2025) %>%
#mutate(year = as.factor(year)) %>%
ggplot(aes(x = lex, fill = year)) +
